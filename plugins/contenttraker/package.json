{
  "name": "contenttraker",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/server.ts --bundle --minify --platform=node --format=esm --target=node18 --outfile=dist/server.mjs",
    "smoke": "npm run build && node tests/smoke.mjs",
    "auth-concurrency": "tsc --noEmit -p tsconfig.tests.json && esbuild tests/auth-concurrency.ts --bundle --platform=node --format=esm --target=node18 --outfile=node_modules/.cache/contenttraker-auth-concurrency.mjs && node node_modules/.cache/contenttraker-auth-concurrency.mjs",
    "runtime-capabilities": "tsc --noEmit -p tsconfig.tests.json && esbuild tests/runtime-capabilities.ts --bundle --platform=node --format=esm --target=node18 --outfile=node_modules/.cache/contenttraker-runtime-capabilities.mjs && node node_modules/.cache/contenttraker-runtime-capabilities.mjs",
    "authorization-interaction": "tsc --noEmit -p tsconfig.tests.json && esbuild tests/authorization-interaction.ts --bundle --platform=node --format=esm --target=node18 --outfile=node_modules/.cache/contenttraker-authorization-interaction.mjs && node node_modules/.cache/contenttraker-authorization-interaction.mjs",
    "credential-store": "tsc --noEmit -p tsconfig.tests.json && esbuild tests/credential-store.ts --bundle --platform=node --format=esm --target=node18 --outfile=node_modules/.cache/contenttraker-credential-store.mjs && node node_modules/.cache/contenttraker-credential-store.mjs",
    "credential-restoration": "tsc --noEmit -p tsconfig.tests.json && esbuild tests/credential-restoration.ts --bundle --platform=node --format=esm --target=node18 --outfile=node_modules/.cache/contenttraker-credential-restoration.mjs && node node_modules/.cache/contenttraker-credential-restoration.mjs",
    "test": "npm run smoke && npm run auth-concurrency && npm run runtime-capabilities && npm run authorization-interaction && npm run credential-store && npm run credential-restoration"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "selfsigned": "^5.5.0",
    "typescript": "^5.8.0",
    "zod": "^3.25.76"
  }
}
